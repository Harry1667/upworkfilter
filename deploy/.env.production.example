# 部署用環境變數範本 — 在 Oracle 上複製成 .env.production 並填好,chmod 600。
# 這個檔不要進 git(已 gitignore)。

# 伺服器
PORT=8787
HOST=127.0.0.1
NODE_ENV=production

# dashboard 登入(務必設,公網一定要)
DASH_USER=admin
DASH_PASSWORD=改成你的強密碼

# 擴充套件 webhook 用的金鑰(擴充套件 webhook URL 帶 ?key=這個)
INGEST_KEY=改成一段隨機字串

# ProxyCLI(產評估網站用;若不在伺服器產可留空)
AI_PROXY_HOST_PORT=cli.twloop.com:443
AI_PROXY_TOKEN=你的_proxycli_token
AI_PROXY_PROJECT=harry-upworkweb
AI_PROXY_GROUP=backend
AI_PROXY_PROVIDER=claude
AI_PROXY_TIER=fast
