# ProxyCLI（hdw-proxycli)AI 代理設定 — 複製成 .env 並填入你的 token / 專案
# REST 端點(產生評估網站時呼叫 AI 用)
AI_PROXY_REST_URL=http://cli.twloop.com:8080

# 你的 ProxyCLI token 與專案名(必填)
AI_PROXY_TOKEN=在此填入你的_token
AI_PROXY_PROJECT=upwork-job-finder
AI_PROXY_GROUP=

# AI 設定(產評估網站建議用高階模型)
AI_PROXY_PROVIDER=claude
AI_PROXY_TIER=high

# Gemini 直連 key(選填)。背景快篩只使用免費池,不會使用付費 key。
# 多把免費 key 用逗號分隔;建議每把來自不同 Google Cloud 專案,額度才會分開。
GEMINI_FREE_API_KEYS=
GEMINI_PAID_API_KEY=
GEMINI_PAID_ENABLED=0

# 🔌 ingest 自動快篩開關。預設(不設或 ≠0)= 擴充功能餵案進來就背景自動 AI 快篩。
# 設 0 = 不在時不燒 token,只做免費規則入庫;打開列表頁手動按「🤖 AI 快篩」才分析。
AI_TRIAGE_ON_INGEST=0

# 🤖 CLI AI 唯讀通道金鑰(選填)— 設了之後,終端機的 AI agent 可帶這把 key 直接讀網站的案+評分
# 用法:curl -H "x-agent-key: <KEY>" http://localhost:3012/api/agent/read/summary
#   或:curl "http://localhost:3012/api/agent/read/jobs?verdict=APPLY&unapplied=1&key=<KEY>"
# 唯讀,不會改任何資料。沒設則此通道關閉(回 401)。
AGENT_KEY=
