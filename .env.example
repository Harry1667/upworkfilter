# ProxyCLI（hdw-proxycli)AI 代理設定 — 複製成 .env 並填入你的 token / 專案
# REST 端點(產生評估網站時呼叫 AI 用)
AI_PROXY_REST_URL=http://cli.twloop.com:8080

# 你的 ProxyCLI token 與專案名(必填)
AI_PROXY_TOKEN=在此填入你的_token
AI_PROXY_PROJECT=upwork-job-finder
AI_PROXY_GROUP=

# AI 設定(產評估網站建議用高階模型)
AI_PROXY_PROVIDER=claude
AI_PROXY_TIER=high
